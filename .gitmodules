[submodule "submodules/Sparkle"]
	path = submodules/Sparkle
	url = https://github.com/macosswift/sparkle.git
	branch = master
[submodule "submodules/telegram-ios"]
	branch = master
	path = submodules/telegram-ios
	url = https://github.com/TelegramMessenger/Telegram-iOS
[submodule "submodules/tgcalls"]
	path = submodules/tgcalls
	url = https://github.com/TelegramMessenger/tgcalls.git
[submodule "submodules/tg_owt"]
	path = submodules/tg_owt
	url = https://github.com/macosswift/tg_owt.git
[submodule "submodules/libprisma"]
	path = submodules/libprisma
	url = https://github.com/TelegramMessenger/libprisma.git
[submodule "submodules/regex"]
	path = submodules/regex
	url = https://github.com/boostorg/regex.git
[submodule "third-party/twidget"]
	path = third-party/twidget
	url = https://github.com/TelegramMessenger/twidget.git
[submodule "submodules/tlottie"]
	path = submodules/tlottie
	url = https://github.com/dkaraush/tlottie.git
[submodule "third-party/widget-sandbox"]
