index 0000000000000000000000000000000000000000..db8e9e633e9bab59c621dd59afc3889326cbd420
--- /dev/null
+++ b/submodules/TelegramCore/Sources/Utils/RGEditHistory.swift
@@ -0,0 +1,67 @@
+#if os(macOS)
+import Foundation
+import Postbox
+import SwiftSignalKit
+import RegramCore
+
+func rgCarryOverLocalMessageAttributes(previousMessage: Message, updatedText: String, updatedAttributes: [MessageAttribute], updatedMedia: [Media], mediaBox: MediaBox, accountId: Int64, cachedPeerData: CachedPeerData?) -> [MessageAttribute] {
+    var attributes = updatedAttributes.filter { !($0 is RGRevokedMessageAttribute || $0 is RGEditHistoryMessageAttribute) }
+    if let revoked = previousMessage.attributes.first(where: { $0 is RGRevokedMessageAttribute }) {
+        attributes.append(revoked)
+    }
+    var editHistory = previousMessage.attributes.first(where: { $0 is RGEditHistoryMessageAttribute }) as? RGEditHistoryMessageAttribute
+    if RegramPreferences.shared.settings(accountId: accountId)["saveEditHistory"].bool, let previousVersion = rgEditHistoryPreviousVersion(previousMessage: previousMessage, updatedText: updatedText, updatedAttributes: updatedAttributes, updatedMedia: updatedMedia, mediaBox: mediaBox, cachedPeerData: cachedPeerData) {
+        editHistory = (editHistory ?? RGEditHistoryMessageAttribute(entries: [])).withAppendedEntry(previousVersion)
+    }
+    if let editHistory {
+        attributes.append(editHistory)
+    }
+    return attributes
+}
+
+private func rgEditHistoryPreviousVersion(previousMessage: Message, updatedText: String, updatedAttributes: [MessageAttribute], updatedMedia: [Media], mediaBox: MediaBox, cachedPeerData: CachedPeerData?) -> RGEditHistoryEntry? {
+    let previousEntities = previousMessage.textEntitiesAttribute?.entities ?? []
+    let previousEditDate = (previousMessage.attributes.first(where: { $0 is EditedMessageAttribute }) as? EditedMessageAttribute)?.date
+    let oldImage = previousMessage.media.compactMap { $0 as? TelegramMediaImage }.first
+    let newImage = updatedMedia.compactMap { $0 as? TelegramMediaImage }.first
+    let spoilerChanged = previousMessage.attributes.contains { $0 is MediaSpoilerMessageAttribute } != updatedAttributes.contains { $0 is MediaSpoilerMessageAttribute }
+    let imageChanged = oldImage?.imageId != newImage?.imageId || (oldImage != nil && spoilerChanged)
+    if previousMessage.text == updatedText && !imageChanged {
+        let updatedEntities = (updatedAttributes.first(where: { $0 is TextEntitiesMessageAttribute }) as? TextEntitiesMessageAttribute)?.entities ?? []
+        let updatedEditDate = (updatedAttributes.first(where: { $0 is EditedMessageAttribute }) as? EditedMessageAttribute)?.date
+        guard previousEntities != updatedEntities, let updatedEditDate, updatedEditDate > (previousEditDate ?? 0) else {
+            return nil
+        }
+    }
+    let privateCopyProtected = (cachedPeerData as? CachedUserData).map { $0.flags.contains(.copyProtectionEnabled) || $0.flags.contains(.myCopyProtectionEnabled) } ?? false
+    let retainImage = previousMessage.id.peerId.namespace != Namespaces.Peer.SecretChat && !previousMessage.containsSecretMedia && !previousMessage.isCopyProtected() && !privateCopyProtected
+    let image = retainImage ? oldImage : nil
+    return RGEditHistoryEntry(text: previousMessage.text, entities: previousEntities, date: previousEditDate ?? previousMessage.timestamp, image: image, imageData: image.flatMap { rgEditHistoryCachedImageData(image: $0, mediaBox: mediaBox) }, imageHasSpoiler: previousMessage.attributes.contains { $0 is MediaSpoilerMessageAttribute })
+}
+
+public func rgEditHistoryCachedImageData(image: TelegramMediaImage, mediaBox: MediaBox) -> Data? {
+    let representations = image.representations.sorted { Int64($0.dimensions.width) * Int64($0.dimensions.height) > Int64($1.dimensions.width) * Int64($1.dimensions.height) }
+    for representation in representations {
+        guard let path = mediaBox.completedResourcePath(representation.resource),
+              let size = (try? FileManager.default.attributesOfItem(atPath: path)[.size]) as? NSNumber,
+              size.intValue <= RGEditHistoryEntry.maximumImageBytes,
+              let data = try? Data(contentsOf: URL(fileURLWithPath: path)), !data.isEmpty else { continue }
+        return data
+    }
+    return nil
+}
+
+public func rgSaveEditHistoryImageData(postbox: Postbox, messageId: MessageId, versionIndex: Int, expectedImageId: MediaId, data: Data) -> Signal<Never, NoError> {
+    return postbox.transaction { transaction in
+        let privateCopyProtected = (transaction.getPeerCachedData(peerId: messageId.peerId) as? CachedUserData).map { $0.flags.contains(.copyProtectionEnabled) || $0.flags.contains(.myCopyProtectionEnabled) } ?? false
+        guard !privateCopyProtected else { return }
+        transaction.updateMessage(messageId, update: { message in
+            guard message.id.peerId.namespace != Namespaces.Peer.SecretChat, !message.containsSecretMedia, !message.isCopyProtected(),
+                  !message.media.contains(where: { $0 is TelegramMediaPaidContent }),
+                  let history = message.rgEditHistory, history.entries.indices.contains(versionIndex), history.entries[versionIndex].image?.imageId == expectedImageId else { return .skip }
+            let attributes: [MessageAttribute] = message.attributes.map { $0 is RGEditHistoryMessageAttribute ? history.withImageData(data, at: versionIndex) : $0 }
+            return .update(StoreMessage(id: message.id, customStableId: nil, globallyUniqueId: message.globallyUniqueId, groupingKey: message.groupingKey, threadId: message.threadId, timestamp: message.timestamp, flags: StoreMessageFlags(message.flags), tags: message.tags, globalTags: message.globalTags, localTags: message.localTags, forwardInfo: message.forwardInfo.flatMap(StoreMessageForwardInfo.init), authorId: message.author?.id, text: message.text, attributes: attributes, media: message.media))
+        })
+    } |> ignoreValues
+}
+#endif
diff --git a/submodules/TelegramCore/Sources/Utils/RGLocalPinnedChats.swift b/submodules/TelegramCore/Sources/Utils/RGLocalPinnedChats.swift
new file mode 100644
index 0000000000000000000000000000000000000000..81ba1384302111e77d0ecee9eecc23bce595c014
--- /dev/null
+++ b/submodules/TelegramCore/Sources/Utils/RGLocalPinnedChats.swift
@@ -0,0 +1,138 @@
+import Foundation
+import Postbox
+
+
+private func rgIsCloudPinnedItem(_ itemId: PinnedItemId) -> Bool {
+    switch itemId {
+    case let .peer(peerId):
+        return peerId.namespace != Namespaces.Peer.SecretChat
+    }
+}
+
+func rgServerPinnedChatLimit(transaction: Transaction, accountPeerId: PeerId, groupId: PeerGroupId) -> Int {
+    var isPremium = false
+    if let user = transaction.getPeer(accountPeerId) as? TelegramUser {
+        isPremium = user.flags.contains(.isPremium)
+    }
+    let appConfiguration = transaction.getPreferencesEntry(key: PreferencesKeys.appConfiguration)?.get(AppConfiguration.self) ?? .defaultValue
+    let limits = UserLimitsConfiguration(appConfiguration: appConfiguration, isPremium: isPremium)
+    if case .root = groupId {
+        return Int(limits.maxPinnedChatCount)
+    } else {
+        return Int(limits.maxArchivedPinnedChatCount)
+    }
+}
+
+func rgSplitPinnedItemIds(_ itemIds: [PinnedItemId], limit: Int) -> (server: [PinnedItemId], overflow: [PinnedItemId]) {
+    var server: [PinnedItemId] = []
+    var overflow: [PinnedItemId] = []
+    var cloudCount = 0
+    for itemId in itemIds {
+        if !rgIsCloudPinnedItem(itemId) {
+            server.append(itemId)
+        } else if cloudCount < limit {
+            server.append(itemId)
+            cloudCount += 1
+        } else {
+            overflow.append(itemId)
+        }
+    }
+    return (server, overflow)
+}
+
+func rgMergeLocalPinnedItemIds(_ order: [PinnedItemId], previousOrder: [PinnedItemId], keep: Set<PinnedItemId>) -> [PinnedItemId] {
+    if keep.isEmpty {
+        return order
+    }
+    var result = order
+    var insertionIndex = 0
+    for itemId in previousOrder {
+        if let index = result.firstIndex(of: itemId) {
+            insertionIndex = index + 1
+        } else if keep.contains(itemId) {
+            result.insert(itemId, at: insertionIndex)
+            insertionIndex += 1
+        }
+    }
+    return result
+}
+
+private struct RGLocalPinnedChatsState: Codable {
+    let peerIds: [Int64]
+}
+
+private func rgLocalPinnedChatsKey(accountPeerId: PeerId, groupId: PeerGroupId) -> ValueBoxKey {
+    return ValueBoxKey("regram.localOverflowPinned.\(accountPeerId.toInt64()).\(groupId.rawValue)")
+}
+
+private func rgLocalOverflowPinnedOrder(transaction: Transaction, accountPeerId: PeerId, groupId: PeerGroupId) -> [PinnedItemId] {
+    let key = rgLocalPinnedChatsKey(accountPeerId: accountPeerId, groupId: groupId)
+    if let state = transaction.getPreferencesEntry(key: key)?.get(RGLocalPinnedChatsState.self) {
+        return state.peerIds.map { .peer(PeerId($0)) }
+    }
+    let order = transaction.getPinnedItemIds(groupId: groupId)
+    let limit = rgServerPinnedChatLimit(transaction: transaction, accountPeerId: accountPeerId, groupId: groupId)
+    let derived = rgSplitPinnedItemIds(order, limit: limit).overflow
+    var seen = Set<PinnedItemId>()
+    let imported = derived.filter { seen.insert($0).inserted }
+    if !imported.isEmpty {
+        rgSetLocalOverflowPinnedItemIds(transaction: transaction, imported, accountPeerId: accountPeerId, groupId: groupId)
+    }
+    return imported
+}
+
+func rgLocalOverflowPinnedItemIds(transaction: Transaction, accountPeerId: PeerId, groupId: PeerGroupId) -> Set<PinnedItemId> {
+    return Set(rgLocalOverflowPinnedOrder(transaction: transaction, accountPeerId: accountPeerId, groupId: groupId))
+}
+
+func rgSetLocalOverflowPinnedItemIds(transaction: Transaction, _ itemIds: [PinnedItemId], accountPeerId: PeerId, groupId: PeerGroupId) {
+    var seen = Set<PinnedItemId>()
+    let peerIds = itemIds.filter { rgIsCloudPinnedItem($0) && seen.insert($0).inserted }.map { itemId -> Int64 in
+        switch itemId {
+        case let .peer(peerId):
+            return peerId.toInt64()
+        }
+    }
+    let key = rgLocalPinnedChatsKey(accountPeerId: accountPeerId, groupId: groupId)
+    transaction.updatePreferencesEntry(key: key, { _ in PreferencesEntry(RGLocalPinnedChatsState(peerIds: peerIds)) })
+}
+
+func rgPrepareLocalPinnedChatsForStateReset(transaction: Transaction, accountPeerId: PeerId) {
+    for groupId: PeerGroupId in [.root, .group(1)] {
+        let order = transaction.getPinnedItemIds(groupId: groupId)
+        let limit = rgServerPinnedChatLimit(transaction: transaction, accountPeerId: accountPeerId, groupId: groupId)
+        var keep = rgLocalOverflowPinnedItemIds(transaction: transaction, accountPeerId: accountPeerId, groupId: groupId)
+        keep.formUnion(rgSplitPinnedItemIds(order, limit: limit).overflow)
+        let stored = rgLocalOverflowPinnedOrder(transaction: transaction, accountPeerId: accountPeerId, groupId: groupId)
+        let preserved = order.filter { keep.contains($0) } + stored.filter { itemId in
+            guard !order.contains(itemId) else { return false }
+            if case let .peer(peerId) = itemId {
+                return transaction.getPeerChatListInclusion(peerId).groupId == groupId
+            }
+            return false
+        }
+        rgSetLocalOverflowPinnedItemIds(transaction: transaction, preserved, accountPeerId: accountPeerId, groupId: groupId)
+    }
+}
+
+func rgSetServerPinnedItemIds(transaction: Transaction, accountPeerId: PeerId, groupId: PeerGroupId, itemIds: [PinnedItemId], restoringState: Bool = false) {
+    let previousOrder = transaction.getPinnedItemIds(groupId: groupId)
+    let overflow = rgLocalOverflowPinnedOrder(transaction: transaction, accountPeerId: accountPeerId, groupId: groupId).filter { itemId in
+        switch itemId {
+        case let .peer(peerId):
+            guard transaction.getPeer(peerId) != nil else { return false }
+            let currentGroup = transaction.getPeerChatListInclusion(peerId).groupId
+            return currentGroup == groupId || (restoringState && currentGroup == nil)
+        }
+    }
+    let overflowSet = Set(overflow)
+    var keep = overflowSet
+    if !previousOrder.contains(where: { itemIds.contains($0) }) {
+        keep.removeAll()
+    }
+    keep.formUnion(previousOrder.filter { !rgIsCloudPinnedItem($0) })
+    var merged = rgMergeLocalPinnedItemIds(itemIds, previousOrder: previousOrder, keep: keep)
+    merged.append(contentsOf: overflow.filter { !merged.contains($0) })
+    transaction.setPinnedItemIds(groupId: groupId, itemIds: merged)
+    rgSetLocalOverflowPinnedItemIds(transaction: transaction, merged.filter { overflowSet.contains($0) && !itemIds.contains($0) }, accountPeerId: accountPeerId, groupId: groupId)
+}
