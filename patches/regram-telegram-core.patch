@@ -0,0 +1,44 @@
+import Foundation
+import Postbox
+
+public class RGRevokedMessageAttribute: MessageAttribute {
+    public let date: Int32
+    public let wasSecretMedia: Bool?
+
+    public init(date: Int32, wasSecretMedia: Bool? = false) {
+        self.date = date
+        self.wasSecretMedia = wasSecretMedia
+    }
+
+    required public init(decoder: PostboxDecoder) {
+        self.date = decoder.decodeInt32ForKey("d", orElse: 0)
+        self.wasSecretMedia = decoder.decodeOptionalInt32ForKey("sm").map { $0 != 0 }
+    }
+
+    public func encode(_ encoder: PostboxEncoder) {
+        encoder.encodeInt32(self.date, forKey: "d")
+        if let wasSecretMedia { encoder.encodeInt32(wasSecretMedia ? 1 : 0, forKey: "sm") } else { encoder.encodeNil(forKey: "sm") }
+    }
+}
+
+public extension Message {
+    var rgIsRevoked: Bool {
+        for attribute in self.attributes {
+            if attribute is RGRevokedMessageAttribute {
+                return true
+            }
+        }
+        return false
+    }
+}
+
+public extension EngineMessage {
+    var rgIsRevoked: Bool {
+        for attribute in self.attributes {
+            if attribute is RGRevokedMessageAttribute {
+                return true
+            }
+        }
+        return false
+    }
+}
