+        _proxy = context.apiEnvironment.socksProxySettings;
+        _endpoint = context.apiEnvironment.rgDoHEndpoint; _preference = context.apiEnvironment.rgIPVersionPreference;
+        _systemDNS = context.apiEnvironment.rgUseSystemDNS;
