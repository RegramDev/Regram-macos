diff --git a/submodules/TelegramCore/Sources/MacOS/RegramMessageHistory.swift b/submodules/TelegramCore/Sources/MacOS/RegramMessageHistory.swift
new file mode 100644
index 00000000..1f8a5bf8
--- /dev/null
+++ b/submodules/TelegramCore/Sources/MacOS/RegramMessageHistory.swift
@@ -0,0 +1,53 @@
+import Postbox
+import SwiftSignalKit
+internal import TelegramApi
+
+public enum RegramMessageHistoryError {
+    case unavailable
+}
+
+public struct RegramMessageHistoryPage {
+    public let messages: [Message]
+    public let nextOffsetId: Int32?
+}
+
+public func regramMessageHistoryPage(account: Account, peerId: PeerId, threadId: Int64?, offsetId: Int32, offsetDate: Int32, limit: Int32 = 100) -> Signal<RegramMessageHistoryPage, RegramMessageHistoryError> {
+    account.postbox.transaction { transaction -> (Peer, Api.InputPeer, Api.InputPeer?)? in
+        guard peerId.namespace != Namespaces.Peer.SecretChat, let peer = transaction.getPeer(peerId), let inputPeer = apiInputPeer(peer) else { return nil }
+        let savedPeer = threadId.flatMap { transaction.getPeer(PeerId($0)) }.flatMap(apiInputPeer)
+        return (peer, inputPeer, savedPeer)
+    }
+    |> castError(RegramMessageHistoryError.self)
+    |> mapToSignal { value -> Signal<RegramMessageHistoryPage, RegramMessageHistoryError> in
+        guard let (peer, inputPeer, savedPeer) = value else { return .fail(.unavailable) }
+        let request: Signal<Api.messages.Messages, RegramMessageHistoryError>
+        if threadId != nil, peerId == account.peerId || peer.isMonoForum {
+            guard let savedPeer else { return .fail(.unavailable) }
+            request = account.network.request(Api.functions.messages.getSavedHistory(flags: peerId == account.peerId ? 0 : 1, parentPeer: peerId == account.peerId ? nil : inputPeer, peer: savedPeer, offsetId: offsetId, offsetDate: offsetDate, addOffset: 0, limit: limit, maxId: 0, minId: 0, hash: 0), automaticFloodWait: false) |> mapError { _ in .unavailable }
+        } else if let threadId {
+            guard let messageId = Int32(exactly: threadId) else { return .fail(.unavailable) }
+            request = account.network.request(Api.functions.messages.getReplies(peer: inputPeer, msgId: messageId, offsetId: offsetId, offsetDate: offsetDate, addOffset: 0, limit: limit, maxId: 0, minId: 0, hash: 0), automaticFloodWait: false) |> mapError { _ in .unavailable }
+        } else {
+            request = account.network.request(Api.functions.messages.getHistory(peer: inputPeer, offsetId: offsetId, offsetDate: offsetDate, addOffset: 0, limit: limit, maxId: 0, minId: 0, hash: 0), automaticFloodWait: false) |> mapError { _ in .unavailable }
+        }
+        return request |> mapToSignal { result in
+            account.postbox.transaction { transaction -> RegramMessageHistoryPage in
+                let messages: [Api.Message]
+                let chats: [Api.Chat]
+                let users: [Api.User]
+                switch result {
+                case let .messages(data): (messages, chats, users) = (data.messages, data.chats, data.users)
+                case let .messagesSlice(data): (messages, chats, users) = (data.messages, data.chats, data.users)
+                case let .channelMessages(data): (messages, chats, users) = (data.messages, data.chats, data.users)
+                case .messagesNotModified: (messages, chats, users) = ([], [], [])
+                }
+                let peers = AccumulatedPeers(transaction: transaction, chats: chats, users: users)
+                updatePeers(transaction: transaction, accountPeerId: account.peerId, peers: peers)
+                let stored = messages.compactMap { StoreMessage(apiMessage: $0, accountPeerId: account.peerId, peerIsForum: peer.isForumOrMonoForum) }
+                _ = transaction.addMessages(stored, location: .Random)
+                let ids: [MessageId] = stored.compactMap { if case let .Id(id) = $0.id { return id }; return nil }
+                return RegramMessageHistoryPage(messages: ids.compactMap(transaction.getMessage), nextOffsetId: ids.map(\.id).min())
+            } |> castError(RegramMessageHistoryError.self)
+        }
+    }
+}
