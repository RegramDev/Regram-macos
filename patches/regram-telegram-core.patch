+#if os(macOS)
+import Foundation
+import Postbox
+import SwiftSignalKit
+import RegramCore
+
+private let regramLocalPremiumAccounts = Atomic<Set<PeerId>>(value: [])
+
+public func rgRegisterLocalPremiumAccountPeerId(_ peerId: PeerId) {
+    _ = regramLocalPremiumAccounts.modify { $0.union([peerId]) }
+}
+
+public func rgUnregisterLocalPremiumAccountPeerId(_ peerId: PeerId) {
+    _ = regramLocalPremiumAccounts.modify { $0.subtracting([peerId]) }
+}
+
+public func rgIsLocalPremiumPeerId(_ peerId: PeerId) -> Bool {
+    guard regramLocalPremiumAccounts.with({ $0.contains(peerId) }) else { return false }
+    return RegramPreferences.shared.settings(accountId: peerId.toInt64())["localPremium"].bool
+}
+
+public func rgStoreLocalPremiumEmojiStatus(peerId: PeerId, status: PeerEmojiStatus?) {
+    guard rgIsLocalPremiumPeerId(peerId) else { return }
+    RegramPreferences.shared.update(accountId: peerId.toInt64()) { settings in
+        var values: [String: String] = [:]
+        if let status, let data = try? JSONEncoder().encode(status), let encoded = String(data: data, encoding: .utf8) {
+            values[String(peerId.toInt64())] = encoded
+        }
+        settings["localPremiumEmojiStatus"] = .dictionary(values)
+    }
+}
+
+public func rgLocalPremiumEmojiStatus(peerId: PeerId) -> PeerEmojiStatus? {
+    guard rgIsLocalPremiumPeerId(peerId),
+          case let .dictionary(values) = RegramPreferences.shared.settings(accountId: peerId.toInt64())["localPremiumEmojiStatus"],
+          let encoded = values[String(peerId.toInt64())], encoded.utf8.count <= 16_384,
+          let data = encoded.data(using: .utf8), let status = try? JSONDecoder().decode(PeerEmojiStatus.self, from: data),
+          status.expirationDate == nil || Int64(status.expirationDate!) > Int64(Date().timeIntervalSince1970) else { return nil }
+    return status
+}
+#endif
