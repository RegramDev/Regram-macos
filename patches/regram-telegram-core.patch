diff --git a/submodules/TelegramCore/Sources/Network/RegramDatacenterDiagnostics.swift b/submodules/TelegramCore/Sources/Network/RegramDatacenterDiagnostics.swift
new file mode 100644
index 0000000000000000000000000000000000000000..f1a27665c8c168ea22b6099d6336828ff0707643
--- /dev/null
+++ b/submodules/TelegramCore/Sources/Network/RegramDatacenterDiagnostics.swift
@@ -0,0 +1,60 @@
+#if os(macOS)
+import Foundation
+import SwiftSignalKit
+internal import TelegramApi
+import MtProtoKit
+
+public struct RegramDatacenterProbeSample {
+    public let datacenterId: Int
+    public let index: Int
+    public let milliseconds: Double?
+    public let timedOut: Bool
+}
+
+public extension Network {
+    func regramTestDatacenter(_ datacenterId: Int) -> Signal<RegramDatacenterProbeSample, NoError> {
+        guard (1...5).contains(datacenterId) else { return .complete() }
+        return self.download(datacenterId: datacenterId, isMedia: false, tag: nil)
+        |> map { Optional($0) }
+        |> timeout(8, queue: .mainQueue(), alternate: .single(nil))
+        |> take(1)
+        |> deliverOnMainQueue
+        |> mapToSignal { worker -> Signal<RegramDatacenterProbeSample, NoError> in
+            guard let worker else { return .single(RegramDatacenterProbeSample(datacenterId: datacenterId, index: 0, milliseconds: nil, timedOut: true)) }
+            return Signal { subscriber in
+                let request = MetaDisposable()
+                let cancelled = Atomic(value: false)
+                var index = 0
+                func next() {
+                    guard !cancelled.with({ $0 }) else { return }
+                    let started = ProcessInfo.processInfo.systemUptime
+                    let currentIndex = index
+                    let holder = MetaDisposable()
+                    request.set(holder)
+                    let signal = worker.request(Api.functions.help.getNearestDc(), automaticFloodWait: false)
+                    |> timeout(8, queue: .mainQueue(), alternate: .fail(MTRpcError(errorCode: 408, errorDescription: "REGRAM_PROBE_TIMEOUT")))
+                    |> deliverOnMainQueue
+                    holder.set(signal.start(next: { value in
+                        guard !cancelled.with({ $0 }) else { return }
+                        let matches: Bool
+                        switch value { case let .nearestDc(details): matches = details.thisDc == Int32(datacenterId) }
+                        subscriber.putNext(RegramDatacenterProbeSample(datacenterId: datacenterId, index: currentIndex, milliseconds: matches ? (ProcessInfo.processInfo.systemUptime - started) * 1000 : nil, timedOut: false))
+                        advance()
+                    }, error: { error in
+                        guard !cancelled.with({ $0 }) else { return }
+                        subscriber.putNext(RegramDatacenterProbeSample(datacenterId: datacenterId, index: currentIndex, milliseconds: nil, timedOut: error.errorCode == 408))
+                        advance()
+                    }))
+                }
+                func advance() {
+                    index += 1
+                    if index == 4 { subscriber.putCompletion() }
+                    else { Queue.mainQueue().after(0.15) { next() } }
+                }
+                next()
+                return ActionDisposable { _ = cancelled.swap(true); request.dispose() }
+            }
+        }
+    }
+}
+#endif
diff --git a/submodules/TelegramCore/Sources/Network/RegramNetworkPolicyBinding.swift b/submodules/TelegramCore/Sources/Network/RegramNetworkPolicyBinding.swift
new file mode 100644
index 0000000000000000000000000000000000000000..c246f53196b67e687463f260e6577cbd3b138e0c
--- /dev/null
+++ b/submodules/TelegramCore/Sources/Network/RegramNetworkPolicyBinding.swift
@@ -0,0 +1,40 @@
+#if os(macOS)
+import Foundation
+import MtProtoKit
+import RegramCore
+
+final class RegramNetworkPolicyBinding {
+    private var observer: NSObjectProtocol?
+    private var policy: RegramNetworkPolicy?
+    private let context: MTContext
+    private let accountId: Int64
+
+    init(context: MTContext, accountId: Int64) {
+        self.context = context
+        self.accountId = accountId
+        self.apply()
+        self.observer = NotificationCenter.default.addObserver(forName: RegramPreferences.didChange, object: nil, queue: .main) { [weak self] notification in
+            guard let self, notification.object as? Int64 == self.accountId else { return }
+            self.apply()
+        }
+    }
+
+    private func apply() {
+        let policy = RegramNetworkPolicy(settings: RegramPreferences.shared.settings(accountId: accountId))
+        guard self.policy != policy else { return }
+        self.policy = policy
+        context.updateApiEnvironment { current in
+            guard let result = current?.copy() as? MTApiEnvironment else { return current }
+            result.rgDoHEndpoint = policy.effectiveEndpoint
+            result.rgUseSystemDNS = policy.dnsMode == .system
+            result.rgIPVersionPreference = Int(policy.ipVersion.rawValue)
+            result.rgDisableBackupAddressDiscovery = policy.disableBackupAddresses
+            return result
+        }
+    }
+
+    deinit {
+        if let observer { NotificationCenter.default.removeObserver(observer) }
+    }
+}
+#endif
