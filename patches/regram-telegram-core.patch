+import Postbox
+
+public final class RegramTranslationMessageAttribute: MessageAttribute {
+    public let configuration: String
+    public let quickToLang: String?
+    public init(configuration: String, quickToLang: String? = nil) { self.configuration = configuration; self.quickToLang = quickToLang }
+    public init(decoder: PostboxDecoder) {
+        self.configuration = decoder.decodeStringForKey("c", orElse: "")
+        self.quickToLang = decoder.decodeOptionalStringForKey("q")
+    }
+    public func encode(_ encoder: PostboxEncoder) {
+        encoder.encodeString(configuration, forKey: "c")
+        if let quickToLang { encoder.encodeString(quickToLang, forKey: "q") }
+    }
+}
