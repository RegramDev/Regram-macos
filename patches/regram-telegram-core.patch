@@ -0,0 +1,115 @@
+import XCTest
+import Postbox
+@testable import TelegramCore
+
+final class RegramPortTests: XCTestCase {
+    private func retainedMessage(attributes: [MessageAttribute], media: [Media] = []) -> Message {
+        Message(stableId: 1, stableVersion: 0, id: MessageId(peerId: PeerId(namespace: Namespaces.Peer.CloudUser, id: ._internalFromInt64Value(10)), namespace: Namespaces.Message.Cloud, id: 1), globallyUniqueId: nil, groupingKey: nil, groupInfo: nil, threadId: nil, timestamp: 1, flags: [.Incoming], tags: [], globalTags: [], localTags: [], customTags: [], forwardInfo: nil, author: nil, text: "retained caption", attributes: attributes, media: media, peers: SimpleDictionary(), associatedMessages: SimpleDictionary(), associatedMessageIds: [], associatedMedia: [:], associatedThreadInfo: nil, associatedStories: [:])
+    }
+
+    func testQuickTranslationDisplayAndOriginalOverrideRoundTrip() {
+        for language in ["de", ""] {
+            let encoder = PostboxEncoder()
+            RegramTranslationMessageAttribute(configuration: "fixture", quickToLang: language).encode(encoder)
+            let decoded = RegramTranslationMessageAttribute(decoder: PostboxDecoder(buffer: MemoryBuffer(data: encoder.makeData())))
+            XCTAssertEqual(decoded.configuration, "fixture")
+            XCTAssertEqual(decoded.quickToLang, language)
+        }
+    }
+
+    private func pin(_ id: Int64) -> PinnedItemId {
+        .peer(PeerId(namespace: Namespaces.Peer.CloudUser, id: PeerId.Id._internalFromInt64Value(id)))
+    }
+
+    func testOverflowPinsSurviveServerReorder() {
+        let previous = (1...7).map { pin(Int64($0)) }
+        let split = rgSplitPinnedItemIds(previous, limit: 5)
+        XCTAssertEqual(split.server, Array(previous.prefix(5)))
+        XCTAssertEqual(split.overflow, [pin(6), pin(7)])
+        let reordered = [pin(3), pin(1), pin(2), pin(4), pin(5)]
+        XCTAssertEqual(rgMergeLocalPinnedItemIds(reordered, previousOrder: previous, keep: Set(split.overflow)), reordered + split.overflow)
+    }
+
+    func testEditHistoryRetainsOriginalAndBoundsVersions() {
+        var history = RGEditHistoryMessageAttribute(entries: [])
+        for index in 0..<70 { history = history.withAppendedEntry(RGEditHistoryEntry(text: "version \(index)", entities: [], date: Int32(index))) }
+        XCTAssertEqual(history.entries.count, 50)
+        XCTAssertEqual(history.entries.first?.text, "version 0")
+        XCTAssertEqual(history.entries.last?.text, "version 69")
+    }
+
+    func testDecodedEditHistoryBoundsImagesAndKeepsOriginalAndNewestVersions() {
+        let image = Data(repeating: 7, count: RGEditHistoryEntry.maximumImageBytes)
+        let entries = (0..<60).map { index in
+            RGEditHistoryEntry(text: "version \(index)", entities: [], date: Int32(index), imageData: index == 0 || index >= 55 ? image : nil)
+        }
+        let encoder = PostboxEncoder()
+        encoder.encodeObjectArray(entries, forKey: "v")
+        let decoded = RGEditHistoryMessageAttribute(decoder: PostboxDecoder(buffer: MemoryBuffer(data: encoder.makeData())))
+        XCTAssertEqual(decoded.entries.count, 50)
+        XCTAssertEqual(decoded.entries.first?.text, "version 0")
+        XCTAssertEqual(decoded.entries.last?.text, "version 59")
+        XCTAssertNotNil(decoded.entries.first?.imageData)
+        XCTAssertNotNil(decoded.entries.last?.imageData)
+        XCTAssertLessThanOrEqual(decoded.entries.reduce(0) { $0 + ($1.imageData?.count ?? 0) }, RGEditHistoryMessageAttribute.maximumImageHistoryBytes)
+        XCTAssertNil(RGEditHistoryEntry(text: "oversized", entities: [], date: 1, imageData: Data(repeating: 1, count: RGEditHistoryEntry.maximumImageBytes + 1)).imageData)
+    }
+
+    func testEditHistoryClearImagesPreservesTextEntitiesAndVersions() {
+        let entity = MessageTextEntity(range: 0..<4, type: .Bold)
+        let history = RGEditHistoryMessageAttribute(entries: [RGEditHistoryEntry(text: "text", entities: [entity], date: 1, imageData: Data([1, 2, 3])), RGEditHistoryEntry(text: "edited", entities: [], date: 2)])
+        let cleared = RGEditHistoryMessageAttribute(entries: history.entries.map { RGEditHistoryEntry(text: $0.text, entities: $0.entities, date: $0.date, image: $0.image, imageHasSpoiler: $0.imageHasSpoiler) })
+        XCTAssertEqual(cleared.entries.map(\.text), history.entries.map(\.text))
+        XCTAssertEqual(cleared.entries.map(\.date), history.entries.map(\.date))
+        XCTAssertEqual(cleared.entries.first?.entities, [entity])
+        XCTAssertTrue(cleared.entries.allSatisfy { $0.imageData == nil })
+    }
+
+    func testExternalTranscriptionCannotBeReplacedByUnsolicitedServerUpdate() {
+        let external = AudioTranscriptionMessageAttribute(id: 0, text: "local result", isPending: false, didRate: true, error: nil, source: .external)
+        let server = AudioTranscriptionMessageAttribute(id: 50, text: "server result", isPending: false, didRate: false, error: nil)
+        XCTAssertEqual(server.merge(withPrevious: external), external)
+        XCTAssertFalse(external.canRate)
+    }
+
+    func testRevocationMarkerRoundTrip() {
+        let encoder = PostboxEncoder()
+        RGRevokedMessageAttribute(date: 1234).encode(encoder)
+        let decoded = RGRevokedMessageAttribute(decoder: PostboxDecoder(buffer: MemoryBuffer(data: encoder.makeData())))
+        XCTAssertEqual(decoded.date, 1234)
+    }
+
+    func testRetainedViewOnceProvenanceSurvivesTimerRemovalAndSerialization() {
+        let image = TelegramMediaImage(imageId: MediaId(namespace: Namespaces.Media.CloudImage, id: 1), representations: [], immediateThumbnailData: nil, reference: nil, partialReference: nil, flags: [])
+        let original = retainedMessage(attributes: [AutoclearTimeoutMessageAttribute(timeout: viewOnceTimeout, countdownBeginTime: 1)], media: [image])
+        XCTAssertTrue(original.containsSecretMedia)
+        let attributes = rgRevokedMessageAttributes(message: original, clearTimers: true, date: 2)
+        XCTAssertFalse(attributes.contains { $0 is AutoclearTimeoutMessageAttribute || $0 is AutoremoveTimeoutMessageAttribute })
+        let marker = attributes.compactMap { $0 as? RGRevokedMessageAttribute }.first!
+        XCTAssertEqual(marker.wasSecretMedia, true)
+        let encoder = PostboxEncoder()
+        marker.encode(encoder)
+        let decoded = RGRevokedMessageAttribute(decoder: PostboxDecoder(buffer: MemoryBuffer(data: encoder.makeData())))
+        let retained = retainedMessage(attributes: [decoded], media: [image])
+        XCTAssertTrue(retained.containsSecretMedia)
+        XCTAssertEqual(retained.text, original.text)
+        XCTAssertEqual((retained.media.first as? TelegramMediaImage)?.imageId, image.imageId)
+        let repeated = rgRevokedMessageAttributes(message: retained, clearTimers: true, date: 3).compactMap { $0 as? RGRevokedMessageAttribute }.first
+        XCTAssertEqual(repeated?.date, 2)
+        XCTAssertEqual(repeated?.wasSecretMedia, true)
+    }
+
+    func testLegacyRevocationProvenanceFailsClosedWithoutGuessing() {
+        let encoder = PostboxEncoder()
+        encoder.encodeInt32(1, forKey: "d")
+        let legacy = RGRevokedMessageAttribute(decoder: PostboxDecoder(buffer: MemoryBuffer(data: encoder.makeData())))
+        XCTAssertNil(legacy.wasSecretMedia)
+        let retained = retainedMessage(attributes: [legacy])
+        XCTAssertTrue(retained.containsSecretMedia)
+        let repeated = rgRevokedMessageAttributes(message: retained, clearTimers: true, date: 3).compactMap { $0 as? RGRevokedMessageAttribute }.first
+        XCTAssertNil(repeated?.wasSecretMedia)
+        let ordinary = retainedMessage(attributes: [])
+        let ordinaryRetained = retainedMessage(attributes: rgRevokedMessageAttributes(message: ordinary, clearTimers: false, date: 4))
