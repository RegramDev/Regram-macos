@@ -0,0 +1,32 @@
+#if os(macOS)
+import Foundation
+import Postbox
+import RegramCore
+
+func rgShouldRetainRevokedMessage(accountId: Int64, transaction: Transaction, id: MessageId) -> Bool {
+    let settings = RegramPreferences.shared.settings(accountId: accountId)
+    return settings.shouldRetainRevokedMessage(peerId: id.peerId.toInt64(), authorIsBot: (transaction.getMessage(id)?.author as? TelegramUser)?.botInfo != nil)
+}
+
+func rgRevokedMessageAttributes(message: Message, clearTimers: Bool, date: Int32) -> [MessageAttribute] {
+    let previous = message.attributes.compactMap { $0 as? RGRevokedMessageAttribute }.first
+    let wasSecretMedia: Bool?
+    if let previous {
+        wasSecretMedia = previous.wasSecretMedia.map { $0 || message.containsSecretMedia }
+    } else {
+        wasSecretMedia = message.containsSecretMedia
+    }
+    var attributes = message.attributes.filter { !($0 is RGRevokedMessageAttribute) }
+    if clearTimers { attributes.removeAll { $0 is AutoremoveTimeoutMessageAttribute || $0 is AutoclearTimeoutMessageAttribute } }
+    attributes.append(RGRevokedMessageAttribute(date: previous?.date ?? date, wasSecretMedia: wasSecretMedia))
+    return attributes
+}
+
+func rgMarkMessageRevoked(transaction: Transaction, id: MessageId, clearTimers: Bool = false) {
+    transaction.updateMessage(id, update: { message in
+        guard !message.rgIsRevoked || clearTimers else { return .skip }
+        let attributes = rgRevokedMessageAttributes(message: message, clearTimers: clearTimers, date: Int32(clamping: Int64(Date().timeIntervalSince1970)))
+        return .update(StoreMessage(id: message.id, customStableId: nil, globallyUniqueId: message.globallyUniqueId, groupingKey: message.groupingKey, threadId: message.threadId, timestamp: message.timestamp, flags: StoreMessageFlags(message.flags), tags: message.tags, globalTags: message.globalTags, localTags: message.localTags, forwardInfo: message.forwardInfo.flatMap(StoreMessageForwardInfo.init), authorId: message.author?.id, text: message.text, attributes: attributes, media: message.media))
+    })
+}
+#endif
