@@ -0,0 +1,15 @@
+import Postbox
+import SwiftSignalKit
+
+public func regramApplyMaxReadIndexInteractively(account: Account, index: MessageIndex, when validate: @escaping (Transaction, () -> Void) -> Void) -> Signal<Bool, NoError> {
+    account.postbox.transaction { transaction -> Bool in
+        guard index.id.peerId.namespace != Namespaces.Peer.SecretChat, peerKeepsReadState(transaction.getPeer(index.id.peerId)) else { return false }
+        var applied = false
+        validate(transaction, {
+            guard !applied else { return }
+            applied = true
+            _internal_applyMaxReadIndexInteractively(transaction: transaction, stateManager: account.stateManager, index: index)
+        })
+        return applied
+    }
+}
