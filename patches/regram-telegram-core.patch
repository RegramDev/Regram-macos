diff --git a/submodules/MTProtoRustEngine/Sources/MTProtoRustEngine/RustNetworkPolicyProxy.swift b/submodules/MTProtoRustEngine/Sources/MTProtoRustEngine/RustNetworkPolicyProxy.swift
new file mode 100644
index 0000000000000000000000000000000000000000..e17170b7c439220553f4444a908d7254b4e79e73
--- /dev/null
+++ b/submodules/MTProtoRustEngine/Sources/MTProtoRustEngine/RustNetworkPolicyProxy.swift
@@ -0,0 +1,179 @@
+import Foundation
+import SwiftSignalKit
+import MtProtoKit
+
+final class RustNetworkPolicyProxy {
+    private struct Success {
+        let address: String
+        let expires: TimeInterval
+    }
+
+    private static let lock = NSLock()
+    private static var successes: [String: Success] = [:]
+    private let queue: Queue
+    private let update: (MTSocksProxySettings?, Bool) -> Void
+    private var lookup: MTDisposable?
+    private var timer: SwiftSignalKit.Timer?
+    private var environment: MTApiEnvironment?
+    private var addresses: [String] = []
+    private var index = 0
+    private var generation = 0
+    private var confirmed = false
+    private var active = false
+    private var key = ""
+    private var retryPending = false
+
+    init(queue: Queue, update: @escaping (MTSocksProxySettings?, Bool) -> Void) {
+        self.queue = queue
+        self.update = update
+    }
+
+    static func policyChanged(_ previous: MTApiEnvironment, _ next: MTApiEnvironment) -> Bool {
+        return previous.rgDoHEndpoint != next.rgDoHEndpoint || previous.rgUseSystemDNS != next.rgUseSystemDNS || previous.rgIPVersionPreference != next.rgIPVersionPreference || previous.rgDisableBackupAddressDiscovery != next.rgDisableBackupAddressDiscovery
+    }
+
+    static func requiresResolution(_ environment: MTApiEnvironment) -> Bool {
+        guard let proxy = environment.socksProxySettings else { return false }
+        if proxy.webProxy { return environment.rgIPVersionPreference == 1 || environment.rgIPVersionPreference == 2 }
+        return MTRGDNSDiagnostics.orderedAddresses([proxy.ip], policy: environment.rgIPVersionPreference).isEmpty
+    }
+
+    static func initialSettings(_ environment: MTApiEnvironment) -> MTSocksProxySettings? {
+        guard let proxy = environment.socksProxySettings, !proxy.webProxy, requiresResolution(environment) else { return environment.socksProxySettings }
+        return MTSocksProxySettings(ip: environment.rgIPVersionPreference == 2 ? "::" : "0.0.0.0", port: proxy.port, username: proxy.username, password: proxy.password, secret: proxy.secret)
+    }
+
+    static func restrictsTransport(_ environment: MTApiEnvironment) -> Bool {
+        return environment.rgIPVersionPreference != 0 || environment.rgDoHEndpoint != nil || environment.rgUseSystemDNS
+    }
+
+    func apply(_ environment: MTApiEnvironment) {
+        self.cancel()
+        self.environment = environment
+        self.confirmed = false
+        self.addresses = []
+        self.index = 0
+        guard let proxy = environment.socksProxySettings else {
+            self.update(nil, false)
+            return
+        }
+        if proxy.webProxy {
+            self.update(proxy, environment.rgIPVersionPreference == 1 || environment.rgIPVersionPreference == 2)
+            return
+        }
+        let literal = MTRGDNSDiagnostics.orderedAddresses([proxy.ip], policy: environment.rgIPVersionPreference)
+        if !literal.isEmpty {
+            self.update(proxy, false)
+            return
+        }
+        var bytes = [UInt8](repeating: 0, count: 16)
+        if proxy.ip.withCString({ inet_pton(AF_INET, $0, &bytes) }) == 1 || proxy.ip.withCString({ inet_pton(AF_INET6, $0, &bytes) }) == 1 {
+            self.update(Self.initialSettings(environment), true)
+            return
+        }
+        self.key = "\(proxy.ip)|\(proxy.port)|\(proxy.secret != nil)|\(environment.rgDoHEndpoint ?? (environment.rgUseSystemDNS ? "system" : "builtin"))|\(environment.rgIPVersionPreference)"
+        self.update(Self.initialSettings(environment), true)
+        let generation = self.generation
+        self.lookup = MTRGDNSDiagnostics.resolveHostname(proxy.ip, endpoint: environment.rgDoHEndpoint, policy: environment.rgIPVersionPreference, useSystemDNS: environment.rgUseSystemDNS).start(next: { [weak self] value in
+            self?.queue.async { [weak self] in
+                guard let self, self.generation == generation, let addresses = value as? [String], !addresses.isEmpty else { return }
+                self.addresses = addresses
+                Self.lock.lock()
+                let success = Self.successes[self.key]
+                Self.lock.unlock()
+                if let success, success.expires > ProcessInfo.processInfo.systemUptime, let index = self.addresses.firstIndex(of: success.address) {
+                    let ipv6 = success.address.contains(":")
+                    let first = environment.rgIPVersionPreference == 0 ? 0 : (self.addresses.firstIndex(where: { $0.contains(":") == ipv6 }) ?? index)
+                    self.addresses.remove(at: index)
+                    self.addresses.insert(success.address, at: first)
+                }
+                self.index = 0
+                self.attemptNext()
+            }
+        }, error: { [weak self] _ in
+            self?.queue.async { [weak self] in
+                guard let self, self.generation == generation else { return }
+                self.scheduleRetry()
+            }
+        }, completed: {})
+    }
+
+    func setActive(_ active: Bool) {
+        guard self.active != active else { return }
+        self.active = active
+        self.timer?.invalidate()
+        self.timer = nil
+        if active && retryPending { self.scheduleRetry() }
+        else if active && !confirmed && !addresses.isEmpty { self.scheduleAttemptTimeout() }
+    }
+
+    func noteServerActivity() {
+        guard !confirmed, index > 0, index <= addresses.count else { return }
+        confirmed = true
+        timer?.invalidate()
+        timer = nil
+        Self.lock.lock()
+        Self.successes = Self.successes.filter { $0.value.expires > ProcessInfo.processInfo.systemUptime }
+        if Self.successes.count >= 128 { Self.successes.removeAll() }
+        Self.successes[key] = Success(address: addresses[index - 1], expires: ProcessInfo.processInfo.systemUptime + 300)
+        Self.lock.unlock()
+    }
+
+    func connectionDropped() {
+        guard active, !addresses.isEmpty else { return }
+        confirmed = false
+        if index >= addresses.count { index = 0 }
+        scheduleAttemptTimeout()
+    }
+
+    private func attemptNext() {
+        timer?.invalidate()
+        timer = nil
+        guard let environment, let proxy = environment.socksProxySettings else { return }
+        guard index < addresses.count else {
+            update(Self.initialSettings(environment), true)
+            scheduleRetry()
+            return
+        }
+        let address = addresses[index]
+        index += 1
+        let settings = MTSocksProxySettings(ip: address, port: proxy.port, username: proxy.username, password: proxy.password, secret: proxy.secret)
+        update(settings, false)
+        if active { scheduleAttemptTimeout() }
+    }
+
+    private func scheduleAttemptTimeout() {
+        let generation = self.generation
+        timer = SwiftSignalKit.Timer(timeout: 4.0, repeat: false, completion: { [weak self] in
+            guard let self, self.generation == generation, !self.confirmed, self.active else { return }
+            self.attemptNext()
+        }, queue: queue)
+        timer?.start()
+    }
+
+    private func scheduleRetry() {
+        retryPending = true
+        guard active else { return }
+        let generation = self.generation
+        timer?.invalidate()
+        timer = SwiftSignalKit.Timer(timeout: 10.0, repeat: false, completion: { [weak self] in
+            guard let self, self.generation == generation, let environment = self.environment else { return }
+            self.apply(environment)
+        }, queue: queue)
+        timer?.start()
+    }
+
+    func cancel() {
+        generation &+= 1
+        retryPending = false
+        lookup?.dispose()
+        lookup = nil
+        timer?.invalidate()
+        timer = nil
+    }
+
+    deinit {
+        lookup?.dispose()
+        timer?.invalidate()
+    }
+}
